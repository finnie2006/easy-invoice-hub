# Docker Compose database settings
DB_USER=invoice_hub
DB_PASSWORD=change_me
DB_NAME=invoice_hub

# Public base URL used for file links and iCal
PUBLIC_URL=http://localhost:8080

# JWT secrets (required in production)
JWT_SECRET=change_me_long_random
JWT_REFRESH_SECRET=change_me_long_random

# Security
ALLOWED_ORIGINS=http://localhost:8080
BODY_LIMIT=1mb
UPLOAD_MAX_MB=10
AUTH_WINDOW_MS=900000
AUTH_MAX_REQUESTS=30

# Container image settings (optional)
APP_IMAGE=ghcr.io/finnie2006/easy-invoice-hub-app
SERVER_IMAGE=ghcr.io/finnie2006/easy-invoice-hub-server
IMAGE_TAG=latest
PULL_POLICY=missing

# OAuth / Authentik (optional, leave empty to disable)
AUTHENTIK_SERVER_URL=https://authentik.example.com
AUTHENTIK_CLIENT_ID=
AUTHENTIK_CLIENT_SECRET=
AUTHENTIK_REDIRECT_URI=http://localhost:8080/auth/callback

# PWA push notifications (optional, recommended in production)
VAPID_SUBJECT=mailto:admin@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
PUSH_CHECK_INTERVAL_MINUTES=60

# Rabobank / Rabo Embedded Services (optional)
# Redirect URI must exactly match the OAuth Redirect URI in the Rabobank Developer Portal.
# Sandbox Premium OAuth base URL: https://oauth-sandbox.rabobank.nl/openapi/sandbox/oauth2-premium
RABO_MODE=premium
RABO_CLIENT_ID=
RABO_CLIENT_SECRET=
RABO_SCOPES=
RABO_OAUTH_BASE_URL=
RABO_REDIRECT_URI=http://localhost:8080/api/rabobank/callback
RABO_NOTIFICATION_PUSH_URI=http://localhost:8080/api/rabobank/notifications
RABO_TOKEN_ENCRYPTION_KEY=
