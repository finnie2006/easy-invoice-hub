# Docker Compose database settings
DB_USER=invoice_hub
DB_PASSWORD=change_me
DB_NAME=invoice_hub

# Public base URL used for file links and iCal
PUBLIC_URL=http://localhost:8080

# JWT secrets (required in production)
JWT_SECRET=change_me_long_random
JWT_REFRESH_SECRET=change_me_long_random

# Security
ALLOWED_ORIGINS=http://localhost:8080
BODY_LIMIT=1mb
UPLOAD_MAX_MB=10
AUTH_WINDOW_MS=900000
AUTH_MAX_REQUESTS=30

# Docker Hub deployment settings (optional)
DOCKERHUB_NAMESPACE=easyinvoicehub
IMAGE_TAG=latest
PULL_POLICY=missing
