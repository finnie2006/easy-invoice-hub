# Server Configuration
PORT=3001
PUBLIC_URL=http://localhost:8080
ALLOWED_ORIGINS=http://localhost:8080

# API hardening
BODY_LIMIT=1mb
UPLOAD_MAX_MB=10
AUTH_WINDOW_MS=900000
AUTH_MAX_REQUESTS=30

# Database Configuration
DB_HOST=postgres
DB_PORT=5432
DB_NAME=invoice_hub
DB_USER=invoice_hub
DB_PASSWORD=invoice_hub_password

# JWT Secrets (CHANGE IN PRODUCTION!)
JWT_SECRET=your-secret-key-change-in-production
JWT_REFRESH_SECRET=your-refresh-secret-key-change-in-production

# PWA push notifications (optional, recommended in production)
VAPID_SUBJECT=mailto:admin@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
PUSH_CHECK_INTERVAL_MINUTES=60

# Rabobank / Rabo Embedded Services (optional)
# Create an application in the Rabobank Developer Portal and register this redirect URI.
RABO_MODE=premium
RABO_CLIENT_ID=
RABO_CLIENT_SECRET=
RABO_SCOPES=
RABO_REDIRECT_URI=http://localhost:8080/api/rabobank/callback
RABO_NOTIFICATION_PUSH_URI=http://localhost:8080/api/rabobank/notifications
RABO_TOKEN_ENCRYPTION_KEY=
